# Common defaults for all hardware profiles.

PROFILE_NAME="common"

# System and user services required for this setup.
SYSTEM_SERVICES=(
  power-profiles-daemon
  greetd
  NetworkManager
  bluetooth
)

USER_SERVICES=(
  pipewire
  pipewire-pulse
  wireplumber
  podman.socket
)

# Verification targets.
ESSENTIAL_BINARIES=(
  niri
  dms
  podman
)

OPTIONAL_BINARIES=(
  vicinae
)

KEYBOARD_LAYOUT="us"
KEYBOARD_VARIANT=""

# USB autosuspend exceptions by idVendor:idProduct.
USB_INPUT_IDS=()

GREETD_CONFIG_RELATIVE_PATH="configs/greetd/config.toml"
USB_UDEV_RULE_SOURCE="udev/50-usb-no-autosuspend.rules"
